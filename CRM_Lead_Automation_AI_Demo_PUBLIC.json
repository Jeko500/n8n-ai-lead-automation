    {
      "parameters": {
        "jsCode": "const urgentWords = [\n  'urgent',\n  'urgently',\n  'emergency',\n  'stopped working',\n  'not working',\n  'no heat',\n  'no cooling',\n  'leak',\n  'flood',\n  'smoke',\n  'burning',\n  'baby',\n  'elderly'\n];\n\nfor (const item of $input.all()) {\n  const message = (item.json.message || '').toLowerCase();\n\n  const matchedKeywords = urgentWords.filter(word =>\n    message.includes(word)\n  );\n\n  item.json.priority =\n    matchedKeywords.length > 0 ? 'HIGH' : 'NORMAL';\n\n  item.json.priorityReason =\n    matchedKeywords.length > 0\n      ? `Urgent keywords: ${matchedKeywords.join(', ')}`\n      : 'No urgent keywords detected';\n}\n\nreturn $input.all();"
      },
