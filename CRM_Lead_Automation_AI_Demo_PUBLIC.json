        "messages": {
          "values": [
            {
              "content": "You are an HVAC lead classification assistant.\n\nAnalyze the customer message and return ONLY valid JSON with these fields:\ncategory, priority, reason.\n\nPriority must be HIGH or NORMAL.\nDo not invent missing information.\n\nCustomer message:\n\"My heating stopped working. I have two small children at home and need help urgently.\"\n\nReturn raw JSON only. Do not use Markdown, code fences or explanations."
            }
          ]
        },
        "options": {}
