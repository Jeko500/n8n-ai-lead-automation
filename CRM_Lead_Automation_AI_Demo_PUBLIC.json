      "id": "5c7b1790-7008-4a3c-852a-d28cc8c84213",
      "name": "When clicking ‘Execute workflow’"
    },
    {
      "parameters": {
        "jsCode": "\nconst results = [];\n\nfor (const item of $input.all()) {\n  const raw = item.json.content;\n  let data;\n  let error = null;\n\n  try {\n    if (typeof raw !== \"string\") {\n      throw new Error(\"AI response is not text\");\n    }\n\n    data = JSON.parse(raw.trim());\n\n    if (!data || typeof data !== \"object\" || Array.isArray(data)) {\n      throw new Error(\"Expected a JSON object\");\n    }\n\n    for (const field of [\"category\", \"priority\", \"reason\"]) {\n      if (\n        typeof data[field] !== \"string\" ||\n        !data[field].trim()\n      ) {\n        throw new Error(\"Invalid or missing field: \" + field);\n      }\n    }\n\n    if (![\"HIGH\", \"NORMAL\"].includes(data.priority)) {\n      throw new Error(\"Invalid priority\");\n    }\n  } catch (e) {\n    error = e.message;\n  }\n\n  results.push({\n    json: {\n      valid: error === null,\n      category: error ? null : data.category,\n      priority: error ? null : data.priority,\n      reason: error ? null : data.reason,\n      error,\n      original_ai_response: raw ?? null\n    }\n  });\n}\n\nreturn results;"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
